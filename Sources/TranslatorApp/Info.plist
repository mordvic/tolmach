<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>LocalTranslator</string>
    <key>CFBundleDisplayName</key><string>Толмач</string>
    <key>CFBundleIdentifier</key><string>com.mordvic.localtranslator</string>
    <!-- Together with Resources/ru.lproj this is what makes macOS render the standard menus in
         Russian. Without either, the bundle claims no localisation, the development region
         defaults to English, and a program whose every string is Russian gets an English menu
         bar even on a Russian system. Measured on one binary under three configurations —
         see the comment in Resources/ru.lproj/Localizable.strings. -->
    <key>CFBundleDevelopmentRegion</key><string>ru</string>
    <key>CFBundleExecutable</key><string>TranslatorApp</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
</dict>
</plist>
